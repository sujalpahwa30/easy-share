PORT=3000

# Use this when the app is deployed or tunneled.
# Local LAN example:
# PUBLIC_BASE_URL=http://192.168.1.4:3000
# Public HTTPS example:
# PUBLIC_BASE_URL=https://easyshare.example.com
PUBLIC_BASE_URL=

# Option 1: simple TURN config.
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=easyshare-user
# TURN_CREDENTIAL=easyshare-password
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Option 2: full ICE server JSON. This overrides TURN_URL when set.
# EASYSHARE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"easyshare-user","credential":"easyshare-password"}]
EASYSHARE_ICE_SERVERS=
